# Backend Firebase service account path (relative to the backend working directory)
FIREBASE_CREDENTIALS=serviceAccountKey.json

# Firebase client (frontend) config (used only in frontend)
REACT_APP_FIREBASE_API_KEY=your_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=sender_id
REACT_APP_FIREBASE_APP_ID=app_id

# Optional: FCM token for a staff device (for testing only)
STAFF_FCM_TOKEN=

# Backend-only ResQPay AI configuration (never use REACT_APP_ for secrets)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox endpoint only; backend rejects PayPal's live API host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
RESQPAY_ADMIN_EMAILS=
RESQPAY_FRONTEND_URL=http://localhost:3000
RESQPAY_CAMERA_INDEX=0
REACT_APP_API_URL=http://localhost:8000
